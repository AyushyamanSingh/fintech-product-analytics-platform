{
  "name": "Vittora Analytics (synthetic)",
  "dataColors": ["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#008300", "#4a3aa7", "#e34948"],
  "background": "#fcfcfb",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#0d366b",
  "center": "#f0efec",
  "minimum": "#2a78d6",
  "textClasses": {
    "callout": {"fontSize": 28, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b"},
    "title": {"fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#0b0b0b"},
    "header": {"fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#52514e"},
    "label": {"fontSize": 10, "fontFace": "Segoe UI", "color": "#52514e"}
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{"show": true, "color": {"solid": {"color": "#fcfcfb"}}, "transparency": 0}],
        "border": [{"show": true, "color": {"solid": {"color": "#e1e0d9"}}, "radius": 8}],
        "title": [{"show": true, "fontColor": {"solid": {"color": "#0b0b0b"}}, "fontSize": 12, "fontFamily": "Segoe UI Semibold", "alignment": "left"}],
        "categoryAxis": [{"gridlineShow": false, "labelColor": {"solid": {"color": "#52514e"}}, "fontSize": 9}],
        "valueAxis": [{"gridlineShow": true, "gridlineColor": {"solid": {"color": "#e1e0d9"}}, "gridlineStyle": "solid", "labelColor": {"solid": {"color": "#52514e"}}, "fontSize": 9}],
        "legend": [{"show": true, "position": "Top", "labelColor": {"solid": {"color": "#52514e"}}, "fontSize": 9}],
        "dropShadow": [{"show": false}]
      }
    },
    "page": {"*": {"background": [{"color": {"solid": {"color": "#f9f9f7"}}, "transparency": 0}]}},
    "card": {"*": {"labels": [{"fontSize": 26, "color": {"solid": {"color": "#0b0b0b"}}}], "categoryLabels": [{"fontSize": 10, "color": {"solid": {"color": "#52514e"}}}]}},
    "lineChart": {"*": {"lineStyles": [{"strokeWidth": 2}]}},
    "tableEx": {"*": {"grid": [{"gridVertical": false, "gridHorizontalColor": {"solid": {"color": "#e1e0d9"}}}], "columnHeaders": [{"fontColor": {"solid": {"color": "#52514e"}}, "backColor": {"solid": {"color": "#fcfcfb"}}}]}}
  }
}
